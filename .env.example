# ---------------------------------------------------------------------------
# Aplicação (Next.js) — exposta em http://localhost:8080 (mapeada de 3000)
# ---------------------------------------------------------------------------
APP_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Metadados (Postgres via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://bitool:bitool@postgres:5432/bitool?schema=public

# ---------------------------------------------------------------------------
# Cube.js — camada semântica, caching e RLS
# ---------------------------------------------------------------------------
CUBEJS_API_URL=http://cube:4000/cubejs-api/v1
CUBEJS_API_SECRET=replace-with-a-long-random-string
CUBEJS_SCHEMA_PATH=schema
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=postgres
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=analytics
CUBEJS_DB_USER=bitool
CUBEJS_DB_PASS=bitool
CUBEJS_DEV_MODE=true
CUBEJS_CACHE_AND_QUEUE_DRIVER=cubestore

# ---------------------------------------------------------------------------
# SAML SSO (EntraID / Okta) — callback fixo na porta 8080
# ---------------------------------------------------------------------------
SAML_CALLBACK_URL=http://localhost:8080/api/auth/callback/saml

# ---------------------------------------------------------------------------
# E-mail (Mailhog local) — usado pelo worker de Alertas
# ---------------------------------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=alerts@bitool.local

# ---------------------------------------------------------------------------
# Alertas — fila via Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
CRON_SECRET=replace-with-a-long-random-string
